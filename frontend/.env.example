# Frontend ENV

# need to add EXPO_PUBLIC_ as a prefix to make variables available via process.env

# EXPO PUBLIC API URL
EXPO_PUBLIC_API_BASE_URL=http://ipaddress:port/api/v1/
# EXPO URLs
EXPO_PUBLIC_BASE_URL=http://ipaddress:port/api/v1/auth # Base URL of your Better Auth 
EXPO_PUBLIC_SCHEME=meowcrosapp # can find in app.json
EXPO_PUBLIC_STORAGE_PREFIX=meowcrosapp