# These are example values to be used for the .env file
# Environment
# development | production | test
NODE_ENV=development

# Port between 1 and 65535
PORT=3000

# Frontend Client Origin
CLIENT_ORIGIN=http://localhost:8081

# Server Origin
SERVER_ORIGIN=http://localhost:

# API 
API_PREFIX=/api/v1

# Neon Postgres db
# https://console.neon.tech/app/org-quiet-field-72391363/projects
# Postgres - connection
# old sslmode=require
# new uselibpqcompat=true&sslmode=require
DATABASE_URL="postgresql://neondb_owner:<owner_connection_string>"
DATABASE_URL_POOLED="postgresql://neondb_owner:<owner_connection_string>"

# BETTER AUTH
# https://better-auth.com/docs/reference/options#secrets on how to rotate secrets
# openssl rand -base64 32 to generate a random secret
BETTER_AUTH_SECRET=your-real-secret
BETTER_AUTH_URL=http://localhost:3000